#: build/videos.js:1
msgid "Video Optimization & Streaming"
msgstr ""

#: build/videos.js:1
msgid "Compress uploads, generate WebM and enable instant playback with FFmpeg. Videos are processed in the background via WP-Cron."
msgstr ""

#: build/videos.js:1
msgid "FFmpeg Engine"
msgstr ""

#: build/videos.js:1
msgid "All video features run through a local FFmpeg binary. Without it, videos are uploaded untouched - nothing breaks."
msgstr ""

#: build/videos.js:1
msgid "FFmpeg detected"
msgstr ""

#: build/videos.js:1
msgid "FFmpeg not found"
msgstr ""

#: build/videos.js:1
msgid "Custom FFmpeg binary path"
msgstr ""

#: build/videos.js:1
msgid "Optional. Leave empty to auto-detect from the system PATH. Example: /usr/bin/ffmpeg or C:\\ffmpeg\\bin\\ffmpeg.exe"
msgstr ""

#: build/videos.js:1
msgid "Re-check"
msgstr ""

#: build/videos.js:1
msgid "exec() is disabled on this server, so FFmpeg cannot be used. Ask your host to enable it - video settings below are saved but will not run until then."
msgstr ""

#: build/videos.js:1
msgid "FFmpeg was not found. Install it on the server (or set its path above and save) to enable video compression, Fast Start and WebM. Image optimization works without it."
msgstr ""

#: build/videos.js:1
msgid "Compression & Formats"
msgstr ""

#: build/videos.js:1
msgid "MP4 / MOV files are re-encoded to H.264 in place and only kept when smaller. WebM (VP9) is added as an extra, lighter source."
msgstr ""

#: build/videos.js:1
msgid "Enable Video Compression & Optimization"
msgstr ""

#: build/videos.js:1
msgid "Needs FFmpeg"
msgstr ""

#: build/videos.js:1
msgid "Enable WebM Format Generation"
msgstr ""

#: build/videos.js:1
msgid "The WebM copy is offered first in [video] players and video blocks; browsers fall back to the MP4."
msgstr ""

#: build/videos.js:1
msgid "Generate a Poster Image"
msgstr ""

#: build/videos.js:1
msgid "Saves a lightweight JPEG frame next to each video and uses it as the poster, so the player shows a picture instantly instead of a black box. Players that already have a poster are left alone."
msgstr ""

#: build/videos.js:1
msgid "Animated GIF to Video"
msgstr ""

#: build/videos.js:1
msgid "Animated GIFs are huge. With this on, each one gets an MP4 (and WebM) copy and visitors see a muted, looping video that is usually 80-95% lighter. The GIF file stays as the fallback."
msgstr ""

#: build/videos.js:1
msgid "Convert Animated GIFs to Video"
msgstr ""

#: build/videos.js:1
msgid "Applies to GIFs inserted at full size in post content, widgets and featured images. Existing GIFs are converted by the Bulk Optimizer."
msgstr ""

#: build/videos.js:1
msgid "Streaming"
msgstr ""

#: build/videos.js:1
msgid "Settings that decide how fast a video starts and how heavy it is to stream."
msgstr ""

#: build/videos.js:1
msgid "Moov Atom \"Fast Start\" Optimization"
msgstr ""

#: build/videos.js:1
msgid "Moves the index to the start of the file so playback begins instantly instead of after the whole file downloads. Lossless."
msgstr ""

#: build/videos.js:1
msgid "Max Video Resolution"
msgstr ""

#: build/videos.js:1
msgid "Videos are never upscaled. Portrait videos are capped on their width."
msgstr ""

