msgstr ""

#: build/images.js:1
msgid "Folders and file patterns"
msgstr ""

#: build/images.js:1
msgid "One per line, matched against the path inside your uploads folder (for example 2025/03/photo.jpg). Plain text matches anywhere in the path, so \"private/\" skips a whole folder. Use * as a wildcard, for example *-original.png."
msgstr ""

#: build/images.js:1
msgid "Excluded folders and file patterns"
msgstr ""

#: build/images.js:1
msgid "Attachment IDs"
msgstr ""

#: build/images.js:1
msgid "Comma separated. Found in the Media Library URL (post=123). ID rules apply to the Bulk Optimizer and to WebP/AVIF creation; use a folder or file pattern to also keep a brand-new upload untouched."
msgstr ""

