#: build/images.js:1
msgid "Image Optimization & Formats"
msgstr ""

#: build/images.js:1
msgid "Compress, resize and convert every image to next-gen formats - right on your own server."
msgstr ""

#: build/images.js:1
msgid "Next-Gen Formats"
msgstr ""

#: build/images.js:1
msgid "A WebP / AVIF copy is created for the original and every thumbnail size. A copy is only kept when it is smaller than the source."
